{
  "compilerOptions": {
    "incremental": true,
    "target": "es2022",
    "module": "commonjs",
    "lib": ["dom", "es2022"],
    "jsx": "react-jsx",
    "strict": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "paths": {
      "crewtimer_video_recorder": ["./release/app/node_modules/crewtimer_video_recorder"]
    },
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": ".erb/dll"
  },
  "exclude": [
    "test",
    "release",
    "release/build",
    "release/app/dist",
    ".erb/dll",
    "node_modules",
    "native"
  ]
}
